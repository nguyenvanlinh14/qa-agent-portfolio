{
  "name": "qa-agent-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "QA Automation portfolio: AI-agent-driven Playwright framework (POM, API, visual, CI reports) + a self-written curriculum (k6, Docker, CI/CD, test design patterns).",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "serve": "node server/app.mjs",
    "pretest": "npm run build",
    "test": "playwright test",
    "test:live": "LIVE=1 playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:visual": "playwright test --project=visual",
    "test:update-snapshots": "playwright test --project=visual --update-snapshots",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "k6:smoke": "k6 run k6/smoke.js",
    "k6:load": "k6 run k6/load.js",
    "k6:stress": "k6 run k6/stress.js",
    "k6:spike": "k6 run k6/spike.js",
    "k6:live": "K6_WEB_DASHBOARD=true K6_WEB_DASHBOARD_OPEN=true K6_WEB_DASHBOARD_EXPORT=reports/k6-load-dashboard.html k6 run k6/load.js",
    "k6:compare": "node scripts/k6-compare.mjs",
    "ai:triage": "node scripts/ai-triage.mjs",
    "evidence:narrate": "node scripts/evidence/narrate.mjs evidence/scripts/watchlist-remove-not-saved.json",
    "evidence:record": "EVIDENCE=1 playwright test --project=evidence --reporter=list",
    "evidence:build": "node scripts/evidence/build-video.mjs evidence/scripts/watchlist-remove-not-saved.json",
    "evidence": "npm run evidence:narrate && npm run evidence:record && npm run evidence:build",
    "evidence:dedupe": "node scripts/evidence/dedupe.mjs",
    "oss:issues": "node scripts/find-good-first-issues.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.10.0",
    "marked": "18.1.2",
    "typescript": "^5.7.0"
  }
}
