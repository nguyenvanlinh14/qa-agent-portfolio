diff --git a/internal/js/modules/k6/webcrypto/tests/derive_bits_test.go b/internal/js/modules/k6/webcrypto/tests/derive_bits_test.go
new file mode 100644
index 00000000..1b9768db
--- /dev/null
+++ b/internal/js/modules/k6/webcrypto/tests/derive_bits_test.go
@@ -0,0 +1,133 @@
+package tests
+
+import (
+	"strconv"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+// These cases cover the lengths accepted by deriveBits for ECDH and X25519, including lengths that
+// are not a multiple of 8, which the Web Platform Tests only exercise for the "8 * size - 11" case.
+func TestDeriveBitsLengths(t *testing.T) {
+	t.Parallel()
+
+	// deriveAll derives the full shared secret and a truncated one from the same key pair.
+	const deriveAll = `
+		const params = (name, namedCurve) => namedCurve ? { name, namedCurve } : name;
+		async function derive(name, namedCurve, length) {
+			const alice = await crypto.subtle.generateKey(params(name, namedCurve), true, ["deriveBits"]);
+			const bob = await crypto.subtle.generateKey(params(name, namedCurve), true, ["deriveBits"]);
+			const full = new Uint8Array(await crypto.subtle.deriveBits(
+				{ name, public: bob.publicKey }, alice.privateKey, FULL_BITS));
+			const part = new Uint8Array(await crypto.subtle.deriveBits(
+				{ name, public: bob.publicKey }, alice.privateKey, length));
+			return { full, part };
+		}
+	`
+
+	testCases := []struct {
+		name  string
+		curve string
+		algo  string
+		bits  int // size of the shared secret in bits
+	}{
+		{name: "ECDH P-256", algo: "ECDH", curve: "P-256", bits: 256},
+		{name: "ECDH P-384", algo: "ECDH", curve: "P-384", bits: 384},
+		{name: "ECDH P-521", algo: "ECDH", curve: "P-521", bits: 528},
+		{name: "X25519", algo: "X25519", bits: 256},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name+" non-multiple of 8 is a masked prefix of the secret", func(t *testing.T) {
+			t.Parallel()
+
+			// 8 * size - 11 is the case used by the Web Platform Tests; 1 and 7 cover the
+			// shortest results and 8 * size - 1 the longest non-multiple of 8.
+			for _, length := range []int{1, 7, 9, tc.bits - 11, tc.bits - 1} {
+				got := runAsync(t, deriveAll+`
+					const FULL_BITS = `+itoa(tc.bits)+`;
+					const length = `+itoa(length)+`;
+					const { full, part } = await derive("`+tc.algo+`", "`+tc.curve+`", length);
+					const bytes = Math.ceil(length / 8);
+					if (part.length !== bytes) return "length " + part.length + " != " + bytes;
+					for (let i = 0; i < bytes - 1; i++) {
+						if (part[i] !== full[i]) return "byte " + i + " differs";
+					}
+					const mask = (0xff << ((8 - (length % 8)) % 8)) & 0xff;
+					if (part[bytes - 1] !== (full[bytes - 1] & mask)) return "last byte is not masked";
+					return "ok";
+				`)
+				assert.Equal(t, "ok", got, "length %d", length)
+			}
+		})
+
+		t.Run(tc.name+" multiple of 8 is a prefix of the secret", func(t *testing.T) {
+			t.Parallel()
+
+			got := runAsync(t, deriveAll+`
+				const FULL_BITS = `+itoa(tc.bits)+`;
+				const { full, part } = await derive("`+tc.algo+`", "`+tc.curve+`", 16);
+				return part.length === 2 && part[0] === full[0] && part[1] === full[1];
+			`)
+			assert.Equal(t, "true", got)
+		})
+
+		t.Run(tc.name+" too long is rejected", func(t *testing.T) {
+			t.Parallel()
+
+			got := runAsync(t, `
+				const alice = await crypto.subtle.generateKey(`+jsParams(tc.algo, tc.curve)+`, true, ["deriveBits"]);
+				const bob = await crypto.subtle.generateKey(`+jsParams(tc.algo, tc.curve)+`, true, ["deriveBits"]);
+				await crypto.subtle.deriveBits({ name: "`+tc.algo+`", public: bob.publicKey }, alice.privateKey, `+itoa(tc.bits+1)+`);
+				return "derived";
+			`)
+			assert.Equal(t, "rejected: OperationError", got)
+		})
+	}
+
+	t.Run("zero length is rejected", func(t *testing.T) {
+		t.Parallel()
+
+		got := runAsync(t, `
+			const alice = await crypto.subtle.generateKey("X25519", true, ["deriveBits"]);
+			const bob = await crypto.subtle.generateKey("X25519", true, ["deriveBits"]);
+			await crypto.subtle.deriveBits({ name: "X25519", public: bob.publicKey }, alice.privateKey, 0);
+			return "derived";
+		`)
+		assert.Equal(t, "rejected: OperationError", got)
+	})
+
+	t.Run("negative length is rejected", func(t *testing.T) {
+		t.Parallel()
+
+		got := runAsync(t, `
+			const alice = await crypto.subtle.generateKey("X25519", true, ["deriveBits"]);
+			const bob = await crypto.subtle.generateKey("X25519", true, ["deriveBits"]);
+			await crypto.subtle.deriveBits({ name: "X25519", public: bob.publicKey }, alice.privateKey, -8);
+			return "derived";
+		`)
+		assert.Equal(t, "rejected: OperationError", got)
+	})
+
+	t.Run("PBKDF2 still requires a multiple of 8", func(t *testing.T) {
+		t.Parallel()
+
+		got := runAsync(t, `
+			const key = await crypto.subtle.importKey("raw", new Uint8Array([1, 2, 3]), "PBKDF2", false, ["deriveBits"]);
+			await crypto.subtle.deriveBits(
+				{ name: "PBKDF2", salt: new Uint8Array([4, 5, 6]), hash: "SHA-256", iterations: 1 }, key, 12);
+			return "derived";
+		`)
+		assert.Equal(t, "rejected: OperationError", got)
+	})
+}
+
+func jsParams(algo, curve string) string {
+	if curve == "" {
+		return `"` + algo + `"`
+	}
+	return `{ name: "` + algo + `", namedCurve: "` + curve + `" }`
+}
+
+func itoa(i int) string { return strconv.Itoa(i) }
